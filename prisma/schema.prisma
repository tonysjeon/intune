generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ComparisonStatus {
  PENDING
  READY
  PROCESSING
  COMPLETED
  FAILED
}

enum ListeningTimeRange {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

enum SyncStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  createdComparisons Comparison[]        @relation("ComparisonCreator")
  comparisonMembers  ComparisonMember[]
  listeningSyncs     ListeningSync[]
  listeningSnapshots ListeningSnapshot[]
  recentPlays        RecentPlay[]
  savedTracks        SavedTrack[]
}

model ListeningSync {
  id          String     @id @default(cuid())
  userId      String
  status      SyncStatus @default(PROCESSING)
  error       String?
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots ListeningSnapshot[]

  @@index([userId, startedAt])
  @@index([status])
}

model ListeningSnapshot {
  id         String             @id @default(cuid())
  syncId     String
  userId     String
  timeRange  ListeningTimeRange
  capturedAt DateTime           @default(now())

  sync       ListeningSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topArtists TopArtist[]
  topTracks  TopTrack[]

  @@unique([syncId, timeRange])
  @@index([userId, timeRange, capturedAt])
}

model SpotifyArtist {
  id        String   @id
  name      String
  uri       String
  imageUrl  String?
  genres    String[]
  updatedAt DateTime @updatedAt

  topEntries TopArtist[]
  tracks     TrackArtist[]
}

model SpotifyTrack {
  id            String   @id
  name          String
  uri           String
  albumName     String
  albumImageUrl String?
  durationMs    Int
  explicit      Boolean
  updatedAt     DateTime @updatedAt

  topEntries  TopTrack[]
  artists     TrackArtist[]
  recentPlays RecentPlay[]
  savedBy     SavedTrack[]
}

model RecentPlay {
  userId     String
  trackId    String
  playedAt   DateTime
  contextUri String?
  createdAt  DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  track SpotifyTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, playedAt])
  @@index([userId, playedAt])
  @@index([trackId])
}

model SavedTrack {
  userId   String
  trackId  String
  addedAt  DateTime
  syncedAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  track SpotifyTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, addedAt])
  @@index([trackId])
}

model TrackArtist {
  trackId  String
  artistId String
  position Int

  track  SpotifyTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist SpotifyArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@unique([trackId, position])
  @@index([artistId])
}

model TopArtist {
  snapshotId String
  artistId   String
  rank       Int

  snapshot ListeningSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  artist   SpotifyArtist     @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([snapshotId, artistId])
  @@unique([snapshotId, rank])
  @@index([artistId])
}

model TopTrack {
  snapshotId String
  trackId    String
  rank       Int

  snapshot ListeningSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  track    SpotifyTrack      @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([snapshotId, trackId])
  @@unique([snapshotId, rank])
  @@index([trackId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Comparison {
  id              String           @id @default(cuid())
  createdByUserId String
  inviteCode      String           @unique @default(cuid())
  status          ComparisonStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  createdBy User               @relation("ComparisonCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members   ComparisonMember[]
  results   ComparisonResult[]

  @@index([createdByUserId])
  @@index([status])
}

model ComparisonMember {
  comparisonId   String
  userId         String
  joinedAt       DateTime @default(now())
  consentVersion String

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([comparisonId, userId])
  @@index([userId])
}

model ComparisonResult {
  id             String   @id @default(cuid())
  comparisonId   String
  modelVersion   String
  overallScore   Float
  artistScore    Float
  trackScore     Float
  genreScore     Float
  embeddingScore Float
  resultJson     Json
  generatedAt    DateTime @default(now())

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, modelVersion])
  @@index([comparisonId, generatedAt])
}
